HTTP_ADDR=:8080

# Misma base que aosc_front / aoscback
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aosc
DB_USERNAME=aosc
DB_PASSWORD=

# Firma de los tokens de la app (mínimo 32 caracteres: openssl rand -hex 32)
JWT_SECRET=
JWT_TTL_DIAS=180

# SMTP (mismos valores MAIL_* que aosc_front). MAIL_ENCRYPTION: tls | ssl | null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="AOSC"

# Link del mail de validación: {VALIDAR_CORREO_URL}/{codigo} (ruta web de aosc_front)
VALIDAR_CORREO_URL=https://aosc.gob.ar/validacion

# Fondo del PDF de la factura: MINIO_ENDPOINT + "/" + AWS_BUCKET de aosc_front
ARCHIVOS_URL=https://s3alertfire.nyc3.digitaloceanspaces.com/aosc

# false = no llama a Wee (checkout y QR fallan/omitidos). Solo para local.
WEE_HABILITADO=true

# Push FCM cada hora. Activar SOLO después de quitar `notificaciones:enviar`
# del scheduler de aosc_front, o los avisos salen duplicados.
NOTIFICACIONES_HABILITADAS=false
FCM_CREDENTIALS=/secrets/firebase-credentials.json
